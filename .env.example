POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# URL de conexão do PostgreSQL (ex.: postgresql://user:pass@localhost:5432/db).
# Obrigatório para API e workers.
DATABASE_URL=

PGADMIN_EMAIL=
PGADMIN_PASSWORD=

GROQ_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# API (services/api) — OBRIGATÓRIOS
# ---------------------------------------------------------------------------
# Chave para assinatura JWT. Gere com:  openssl rand -hex 32
JWT_SECRET=

# Emissor (iss) e audiência (aud) dos tokens JWT. Defaults isolam o produto;
# em staging use valores próprios (ex.: prospect-ai-staging) para que um
# token de um ambiente nunca seja aceito em outro.
JWT_ISSUER=prospect-ai
JWT_AUDIENCE=prospect-ai-api
# Algoritmo e expiração dos tokens (defaults: HS256, 24h).
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=24

# Ambiente: development (padrão) ou production.
# Em production, SMTP ausente faz o envio de e-mail falhar (não "fingir").
ENVIRONMENT=development

# Origins CORS permitidas (vírgula-separado). Em produção, inclua o domínio
# do frontend (ex.: https://app.empresa.com.br).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Intervalo (s) do scheduler de follow-ups vencidos (cadência).
CADENCE_POLL_SECONDS=60

# Intervalo (s) do job-consumer do pipeline (coleta/enriquecimento em background).
# Jobs PENDING são consumidos um por vez em loop dedicado — não trava a request.
JOB_POLL_SECONDS=5

# Resiliência a rate-limit da Groq (HTTP 429 — janela ~60s no tier free).
# Pacing: intervalo mínimo entre o início de chamadas Groq no processo.
# Retry: em 429 a Groq informa Retry-After; sem ele, backoff base*2^tentativa
# limitado a GROQ_RETRY_MAX_SECONDS. Quanto menor o intervalo, mais rápido o
# batch — mas mais retries de 429 (e possível perda de chamadas).
GROQ_MIN_INTERVAL_SECONDS=20
GROQ_MAX_RETRIES=5
GROQ_RETRY_BASE_SECONDS=4
GROQ_RETRY_MAX_SECONDS=60

# Modelos Groq (centralizados — troca de modelo = editar aqui, não os serviços).
# CLASSIFY: classificação curta (scoring e router de template).
# GENERATION: texto client-facing (outreach, segmentos, brief, templates gerados).
GROQ_MODEL_CLASSIFY=openai/gpt-oss-20b
GROQ_MODEL_GENERATION=qwen/qwen3.6-27b

# Teto diário default de envios automáticos da cadência por org (item 4.3).
# Cada org pode sobrescrever em /configuracoes (estende a janela e o teto).
DAILY_EMAIL_LIMIT=40

# Segredo compartilhado com o provedor de inbound email (Postmark/SendGrid).
# Vazio = webhook de resposta/STOP desativado.
EMAIL_WEBHOOK_SECRET=

# Chave mestra para criptografar secrets BYOK por organização (item 3.5).
# Fernet 32-byte base64-urlsafe. Sem ela, o sistema deriva uma chave do
# DATABASE_URL (apenas para desenvolvimento). Em produção, defina SEMPRE.
SECRETS_ENCRYPTION_KEY=

# Opcional — Hunter.io para e-mail de decisor (item 3.4).
# Sem a chave, o enriquecimento usa fallback gratuito (CNPJ/Receita + heurística).
HUNTER_API_KEY=

# Opcional — fonte especializada de pessoas via endpoint JSON próprio
# (Apollo/Clay/Snov/base interna). Exige opt-in da org em api_quota
# (`PEOPLE_DISCOVERY_HTTP`); vazio mantém o provider desabilitado.
PEOPLE_DISCOVERY_URL=
PEOPLE_DISCOVERY_TOKEN=
PEOPLE_DISCOVERY_MAX_RETRIES=1

# Tracking de abertura/clique (4.2) — URL pública da API que o cliente de e-mail
# do destinatário acessa para o pixel 1x1 e o redirect de clique (ex.:
# https://api.empresa.com.br). Vazio = tracking desativado (sem injetar pixel).
TRACKING_BASE_URL=

# PORT=3001

# ---------------------------------------------------------------------------
# Web (apps/web/.env.local) — OBRIGATÓRIO
# ---------------------------------------------------------------------------
# Secret do NextAuth (JWT de sessão). Gere com:  openssl rand -base64 32
# Sem ele o NextAuth gera um secret aleatório por processo e o login falha com
# JWT_SESSION_ERROR "decryption operation failed" ao ler a sessão no render.
NEXTAUTH_SECRET=

# Password reset
RESET_TOKEN_EXPIRY_HOURS=2
APP_BASE_URL=http://localhost:3001

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@prospect.ai
SMTP_FROM_NAME=Prospect.ai